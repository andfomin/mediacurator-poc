# --- Azure Blob Storage (both must already exist) ---------------------------
# Account NAME only, not a URL and not a connection string.
AZURE_STORAGE_ACCOUNT=<your-account>
AZURE_BLOB_CONTAINER=<your-container>

# Only needed if the web app uses a USER-assigned managed identity.
# Leave blank for a system-assigned identity or for local `az login`.
# AZURE_CLIENT_ID=

# --- Write access -----------------------------------------------------------
# Guards uploads and deletes. Agents send it as `Authorization: Bearer <secret>`;
# the browser exchanges it for a signed cookie via the unlock form.
API_SECRET=change-me-to-something-long-and-random

# Signs the unlock cookie. Any long random string. Changing it logs everyone out.
COOKIE_SECRET=change-me-too

# --- Optional ---------------------------------------------------------------
# Largest accepted upload, in bytes. Default 536870912 (512 MB).
# MAX_UPLOAD_BYTES=536870912

# Local port. Azure App Service injects PORT itself.
# PORT=3000
